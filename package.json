{
  "name": "areopagus",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm site:check",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "site:check": "node scripts/check-locales.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:review": "node scripts/review-locales.mjs",
    "start": "pnpm --filter @areopagus/web start"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
